// The app, for the myzig CLI: `myzig build` packages it, with its icon and
// the NSIS installer (`MyCode Setup <version> x86_64.exe`).
.{
    .name = "MyCode",
    .identifier = "com.hunghg255.mycode",
    .copyright = "Copyright hunghg255",
    .icon = "resources/icon.png",
    .executable = "mycode",
    // Uninstalling takes the `mycode` command and "Open with MyCode" away
    // (the Go app's too), and offers to delete the settings.
    .windows = .{
        .installer = true,
        .uninstall_run = "--uninstall-shell",
        .uninstall_data = .{ "$APPDATA\\MyCode", "$LOCALAPPDATA\\MyCode" },
    },
}
